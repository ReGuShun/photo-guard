@@ -0,0 +1,37 @@
+import unittest
+
+import numpy as np
+from PIL import Image
+
+from face_pose_alignment import align_pose, fill_missing_boxes, select_face
+
+
+class FaceAlignmentTests(unittest.TestCase):
+    def test_whole_body_and_face_center(self):
+        pixels = np.zeros((100, 100, 3), dtype=np.uint8)
+        pixels[65:70, 45:50] = 255
+        face = np.array([40, 10, 60, 30])
+        target = np.array([70, 20, 110, 60])
+        result, matrix = align_pose(Image.fromarray(pixels), face, target, (100, 100), (200, 200))
+        np.testing.assert_allclose(matrix @ [50, 20, 1], [90, 40])
+        self.assertEqual(matrix[0, 0], matrix[1, 1])
+        self.assertGreater(result[135, 85].max(), 0)
+        self.assertEqual(result[0, 0].max(), 0)
+        self.assertEqual(result.shape, (200, 200, 3))
+
+    def test_missing_faces(self):
+        box = np.array([10, 10, 20, 20])
+        filled = fill_missing_boxes([box, None, box + 2])
+        np.testing.assert_allclose(filled[1], box + 1)
+        with self.assertRaises(RuntimeError):
+            fill_missing_boxes([None] * 20)
+        with self.assertRaises(RuntimeError):
+            fill_missing_boxes([box] + [None] * 13)
+
+    def test_tracking(self):
+        box = np.array([10, 10, 20, 20])
+        np.testing.assert_array_equal(select_face([box + 100, box + 1], box), box + 1)
+
+
+if __name__ == "__main__":
+    unittest.main()
