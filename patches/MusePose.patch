--- /dev/null
+++ b/face_pose_alignment.py
@@ -0,0 +1,130 @@
+from pathlib import Path
+
+import cv2
+import numpy as np
+import onnxruntime as ort
+
+
+class FaceDetector:
+    def __init__(self, model_path):
+        if not Path(model_path).is_file():
+            raise FileNotFoundError(f"Face detector weights missing: {model_path}")
+        options = ort.SessionOptions()
+        options.intra_op_num_threads = 1
+        self.session = ort.InferenceSession(
+            str(model_path), sess_options=options, providers=["CPUExecutionProvider"]
+        )
+
+    def detect(self, image):
+        # Match the local FaceFusion YOLOFace BGR/top-left padding convention.
+        frame = cv2.cvtColor(np.asarray(image.convert("RGB")), cv2.COLOR_RGB2BGR)
+        height, width = frame.shape[:2]
+        ratio = min(1.0, 640 / width, 640 / height)
+        small = cv2.resize(frame, (max(1, int(width * ratio)), max(1, int(height * ratio))))
+        canvas = np.zeros((640, 640, 3), dtype=np.float32)
+        h, w = small.shape[:2]
+        canvas[:h, :w] = small
+        tensor = (canvas.transpose(2, 0, 1)[None] / 255).astype(np.float32)
+        rows = np.squeeze(self.session.run(None, {"input": tensor})[0]).T
+        boxes, scores = [], []
+        for row in rows[rows[:, 4] >= 0.5]:
+            cx, cy, bw, bh = row[:4]
+            x1, x2 = np.clip([(cx - bw / 2) * width / w, (cx + bw / 2) * width / w], 0, width)
+            y1, y2 = np.clip([(cy - bh / 2) * height / h, (cy + bh / 2) * height / h], 0, height)
+            if x2 > x1 and y2 > y1:
+                boxes.append([float(x1), float(y1), float(x2 - x1), float(y2 - y1)])
+                scores.append(float(row[4]))
+        keep = np.asarray(cv2.dnn.NMSBoxes(boxes, scores, 0.5, 0.4)).reshape(-1)
+        return [np.array([boxes[i][0], boxes[i][1], boxes[i][0] + boxes[i][2], boxes[i][1] + boxes[i][3]]) for i in keep]
+
+
+class PersonDetector:
+    """Ultralytics YOLO person detector used to identify the main subject."""
+
+    def __init__(self, model_path, device="cpu"):
+        try:
+            from ultralytics import YOLO
+        except ImportError as exc:
+            raise RuntimeError("人物 YOLO 检测需要 ultralytics。") from exc
+        self.model = YOLO(str(model_path))
+        self.device = device
+
+    def detect(self, image):
+        result = self.model.predict(
+            source=np.asarray(image.convert("RGB")),
+            classes=[0],
+            conf=0.25,
+            iou=0.5,
+            device=self.device,
+            verbose=False,
+        )[0]
+        if result.boxes is None or len(result.boxes) == 0:
+            return []
+        return [box.detach().cpu().numpy().astype(np.float64) for box in result.boxes.xyxy]
+
+
+def select_face(boxes, previous=None):
+    if not boxes:
+        return None
+    if previous is None:
+        return max(boxes, key=lambda b: (b[2] - b[0]) * (b[3] - b[1]))
+    center = (previous[:2] + previous[2:]) / 2
+    return min(boxes, key=lambda b: np.linalg.norm((b[:2] + b[2:]) / 2 - center))
+
+
+def select_person(boxes, previous=None):
+    if not boxes:
+        return None
+    if previous is None:
+        return max(boxes, key=lambda b: (b[2] - b[0]) * (b[3] - b[1]))
+    center = (previous[:2] + previous[2:]) / 2
+    return min(boxes, key=lambda b: np.linalg.norm((b[:2] + b[2:]) / 2 - center))
+
+
+def face_inside_person(face, person):
+    if face is None or person is None:
+        return False
+    center = (face[:2] + face[2:]) / 2
+    return bool(person[0] <= center[0] <= person[2] and person[1] <= center[1] <= person[3])
+
+
+def fill_missing_boxes(boxes, max_gap=12):
+    valid = [i for i, box in enumerate(boxes) if box is not None]
+    if not valid:
+        raise RuntimeError("驱动视频未检测到人脸，无法进行人脸对齐。")
+    gaps = [valid[0], len(boxes) - 1 - valid[-1]] + [b - a - 1 for a, b in zip(valid, valid[1:])]
+    if max(gaps) > max_gap:
+        raise RuntimeError(f"驱动视频连续漏检人脸超过 {max_gap} 帧，请更换清晰的驱动视频。")
+    values = np.stack([boxes[i] for i in valid])
+    return np.stack([np.interp(np.arange(len(boxes)), valid, values[:, j]) for j in range(4)], axis=1)
+
+
+def align_pose(pose_image, source_box, reference_box, source_size, target_size):
+    source_box = np.asarray(source_box, dtype=np.float64).copy()
+    source_box[[0, 2]] *= pose_image.width / source_size[0]
+    source_box[[1, 3]] *= pose_image.height / source_size[1]
+    source_center = (source_box[:2] + source_box[2:]) / 2
+    target_center = (reference_box[:2] + reference_box[2:]) / 2
+    source_extent = source_box[2:] - source_box[:2]
+    target_extent = reference_box[2:] - reference_box[:2]
+    scale = float(np.sqrt(np.prod(target_extent) / np.prod(source_extent)))
+    offset = target_center - scale * source_center
+    matrix = np.array([[scale, 0, offset[0]], [0, scale, offset[1]]], dtype=np.float64)
+    aligned = cv2.warpAffine(np.asarray(pose_image.convert("RGB")), matrix, target_size,
+                             flags=cv2.INTER_LINEAR, borderMode=cv2.BORDER_CONSTANT, borderValue=0)
+    return aligned, matrix
+
+
+def align_frame(frame, source_box, reference_box, target_size):
+    """Align the complete RGB driving frame using its face as the anchor."""
+    source_box = np.asarray(source_box, dtype=np.float64)
+    source_center = (source_box[:2] + source_box[2:]) / 2
+    target_center = (np.asarray(reference_box[:2]) + np.asarray(reference_box[2:])) / 2
+    source_extent = source_box[2:] - source_box[:2]
+    target_extent = np.asarray(reference_box[2:]) - np.asarray(reference_box[:2])
+    scale = float(np.sqrt(np.prod(target_extent) / np.prod(source_extent)))
+    offset = target_center - scale * source_center
+    matrix = np.array([[scale, 0, offset[0]], [0, scale, offset[1]]], dtype=np.float64)
+    aligned = cv2.warpAffine(np.asarray(frame.convert("RGB")), matrix, target_size,
+                             flags=cv2.INTER_LINEAR, borderMode=cv2.BORDER_CONSTANT, borderValue=0)
+    return aligned, matrix
