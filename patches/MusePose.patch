@@ -0,0 +1,171 @@
+import argparse
+import json
+import os
+import sys
+from pathlib import Path
+
+import numpy as np
+import torch
+import av
+from PIL import Image
+from face_pose_alignment import (
+    FaceDetector, PersonDetector, select_face, select_person,
+    face_inside_person, fill_missing_boxes, align_pose, align_frame,
+)
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--reference", required=True)
+    parser.add_argument("--driving", required=True)
+    parser.add_argument("--pose_out", required=True)
+    parser.add_argument("--aligned_driving_out", required=True)
+    parser.add_argument(
+        "--control_parts",
+        choices=("body", "body_hand", "full"),
+        default="body_hand",
+        help="Pose parts to draw into the control video.",
+    )
+    args = parser.parse_args()
+
+    reference_path = Path(args.reference)
+    if not reference_path.is_file():
+        raise FileNotFoundError(f"参考图片不存在: {reference_path}")
+    with Image.open(reference_path) as reference_image:
+        target_width, target_height = reference_image.convert("RGB").size
+    if target_width < 1 or target_height < 1:
+        raise ValueError("参考图片尺寸无效。")
+    print(f"pose output size: {target_width}x{target_height}")
+
+    repo = Path(__file__).resolve().parent
+    sys.path.insert(0, str(repo))
+
+    from pose.script.tool import get_fps, read_frames
+
+    # Use the ONNX DWPose implementation bundled with Dormant.  The original
+    # MusePose path imports mmcv/mmpose/mmdet, which are optional and may not
+    # be installed in the inference environment.
+    dormant_root = Path(os.environ.get("PHOTO_PROJECT_ROOT", str(repo.parent))) / "Dormant"
+    if not (dormant_root / "pretrained_weights/DWPose/yolox_l.onnx").exists():
+        raise FileNotFoundError(
+            "Dormant ONNX DWPose 权重不存在: "
+            f"{dormant_root / 'pretrained_weights/DWPose/yolox_l.onnx'}"
+        )
+    if not (dormant_root / "pretrained_weights/DWPose/dw-ll_ucoco_384.onnx").exists():
+        raise FileNotFoundError(
+            "Dormant ONNX DWPose 权重不存在: "
+            f"{dormant_root / 'pretrained_weights/DWPose/dw-ll_ucoco_384.onnx'}"
+        )
+
+    sys.path.insert(0, str(dormant_root))
+    from model_lib.dwpose import DWposeDetector
+    previous_cwd = Path.cwd()
+    os.chdir(dormant_root)
+    try:
+        detector = DWposeDetector().to(
+            "cuda" if torch.cuda.is_available() else "cpu"
+        )
+    finally:
+        os.chdir(previous_cwd)
+
+    frames = read_frames(args.driving)
+    fps = get_fps(args.driving)
+    if not frames:
+        raise RuntimeError("驱动视频没有可读取的视频帧。")
+    face_detector = FaceDetector(str(Path(os.environ.get("YOLOFACE_MODEL", str(repo.parent / "models/yolo/yoloface_8n.onnx")))))
+    person_detector = PersonDetector(str(Path(os.environ.get("YOLO_PERSON_MODEL", str(repo.parent / "models/yolo/yolov8n.pt")))))
+    with Image.open(reference_path) as image:
+        reference_people = person_detector.detect(image)
+        reference_person = select_person(reference_people)
+        reference_faces = face_detector.detect(image)
+        reference_bbox = select_face(
+            [face for face in reference_faces if face_inside_person(face, reference_person)]
+            or reference_faces
+        )
+    if reference_bbox is None:
+        raise RuntimeError("参考图片未检测到人脸，无法进行人脸对齐。")
+    if reference_person is None:
+        raise RuntimeError("参考图片未检测到人物，无法进行人物和人脸对齐。")
+    print(f"YOLO person reference bbox: {reference_person.tolist()}", flush=True)
+    print(f"YOLOFace reference face bbox: {reference_bbox.tolist()}", flush=True)
+    face_boxes = []
+    person_boxes = []
+    previous_face = None
+    previous_person = reference_person
+    for frame in frames:
+        people = person_detector.detect(frame)
+        person = select_person(people, previous_person)
+        faces = face_detector.detect(frame)
+        scoped_faces = [face for face in faces if face_inside_person(face, person)]
+        box = select_face(scoped_faces or faces, previous_face)
+        person_boxes.append(person)
+        face_boxes.append(box)
+        if person is not None:
+            previous_person = person
+        if box is not None:
+            previous_face = box
+    if not any(person is not None for person in person_boxes):
+        raise RuntimeError("驱动视频未检测到人物，无法进行人物和人脸对齐。")
+    filled_boxes = fill_missing_boxes(face_boxes)
+    filled_person_boxes = fill_missing_boxes(person_boxes)
+    print(f"YOLO person detected: {sum(b is not None for b in person_boxes)}/{len(frames)}", flush=True)
+    print(f"YOLOFace detected faces: {sum(b is not None for b in face_boxes)}/{len(frames)}", flush=True)
+    diagnostics = {"reference_person": reference_person.tolist(), "reference_face": reference_bbox.tolist(),
+                   "target_size": [target_width, target_height], "frames": []}
+    pose_frames = []
+    aligned_frames = []
+    for index, frame in enumerate(frames):
+        aligned_frame, frame_matrix = align_frame(frame, filled_boxes[index], reference_bbox,
+                                                   (target_width, target_height))
+        aligned_frames.append(Image.fromarray(aligned_frame))
+        detected_map, _ = detector(
+            aligned_frames[-1],
+            detect_resolution=1024,
+            image_resolution=768,
+            output_type="pil",
+            control_parts=args.control_parts,
+        )
+        # DWPose already runs on the aligned RGB frame. Keep a final exact-size
+        # canvas pass so its rendered skeleton and the driving frame coincide.
+        pose_frames.append(detected_map.resize((target_width, target_height), Image.Resampling.BILINEAR))
+        diagnostics["frames"].append({"frame": index, "person_detected": person_boxes[index] is not None,
+                                      "person_box": filled_person_boxes[index].tolist(),
+                                      "face_detected": face_boxes[index] is not None,
+                                      "source_face": filled_boxes[index].tolist(), "transform": frame_matrix.tolist()})
+        if index % 20 == 0:
+            print(f"face-aligned pose frames: {index + 1}/{len(frames)}", flush=True)
+
+    if not pose_frames:
+        raise RuntimeError("驱动视频没有可读取的视频帧。")
+    # Keep the exact reference-image dimensions.  yuv420p/libx264 requires
+    # even dimensions, so use yuv444p for odd-sized inputs such as 805x1440.
+    os.makedirs(Path(args.pose_out).parent, exist_ok=True)
+    Path(args.pose_out).with_suffix(".alignment.json").write_text(json.dumps(diagnostics, indent=2), encoding="utf-8")
+    aligned_container = av.open(str(args.aligned_driving_out), "w")
+    aligned_stream = aligned_container.add_stream("libx264", rate=int(np.around(float(fps))))
+    aligned_stream.width = target_width
+    aligned_stream.height = target_height
+    aligned_stream.pix_fmt = "yuv444p"
+    aligned_stream.options["crf"] = "18"
+    try:
+        for aligned_frame in aligned_frames:
+            aligned_container.mux(aligned_stream.encode(av.VideoFrame.from_image(aligned_frame)))
+        aligned_container.mux(aligned_stream.encode())
+    finally:
+        aligned_container.close()
+    container = av.open(str(args.pose_out), "w")
+    stream = container.add_stream("libx264", rate=int(np.around(float(fps))))
+    stream.width = target_width
+    stream.height = target_height
+    stream.pix_fmt = "yuv444p"
+    stream.options["crf"] = "18"
+    try:
+        for pose_frame in pose_frames:
+            container.mux(stream.encode(av.VideoFrame.from_image(pose_frame)))
+        container.mux(stream.encode())
+    finally:
+        container.close()
+
+
+if __name__ == "__main__":
+    main()
